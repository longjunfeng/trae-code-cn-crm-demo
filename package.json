{
  "name": "trae-code-cn-crm-demo",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "tsx server/src/index.ts",
    "build": "vite build --config web/vite.config.ts",
    "test": "playwright test",
    "test:api": "tsx server/src/api.test.ts",
    "preview": "vite preview --config web/vite.config.ts"
  },
  "dependencies": { "@vitejs/plugin-vue": "latest", "concurrently": "latest", "express": "latest", "tsx": "latest", "vite": "latest", "vue": "latest" },
  "devDependencies": { "@playwright/test": "latest", "typescript": "latest" }
}
